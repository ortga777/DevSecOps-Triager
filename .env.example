DECIDER_MODEL_ID=<your-bedrock-model-id>
GITHUB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:devsecops-triager/github
GITHUB_WEBHOOK_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:devsecops-triager/webhook
MAX_DIFF_CHARS=60000
MAX_LOG_CHARS=30000

GITHUB_AUTH_MODE=app
# GitHub App secret JSON: {"app_id":"...","private_key":"-----BEGIN PRIVATE KEY-----...","installation_id":"..."}
